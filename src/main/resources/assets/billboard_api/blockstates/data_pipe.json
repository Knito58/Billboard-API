{
  "multipart": [
    {
      "apply": {
        "model": "billboard_api:block/data_pipe_core"
      }
    },
    {
      "when": {
        "north": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm"
      }
    },
    {
      "when": {
        "east": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "connected"
      },
      "apply": {
        "model": "billboard_api:block/data_pipe_arm",
        "x": 90
      }
    }
  ]
}
